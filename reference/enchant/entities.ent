<!--
    See `manual.xml` for XML namespaces defaults.
    Keep the lines under 79 columns, to make the process of manual
    translation easier, and to avoid wrap-around in some other contexts.
-->
<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.enchant.broker-valueerror">
 <simpara>
  Функция выбрасывает исключение <exceptionname>ValueError</exceptionname>, если
  параметр <parameter>broker</parameter> непригоден к использованию, например,
  если он не был инициализирован или уже освобождён функцией
  <function>enchant_broker_free</function>.
 </simpara>
</entity>

<entity name="ext.enchant.dict-valueerror">
 <simpara>
  Функция выбрасывает исключение <exceptionname>ValueError</exceptionname>, если
  параметр <parameter>dictionary</parameter> непригоден к использованию, например,
  если он не был инициализирован или уже освобождён функцией
  <function>enchant_broker_free_dict</function>.
 </simpara>
</entity>

</entities>
