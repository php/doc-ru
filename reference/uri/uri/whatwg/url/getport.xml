<refentry xml:id="uri-whatwg-url.getport" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Uri\WhatWg\Url::getPort</refname>
  <refpurpose>Получает порт</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Uri\\WhatWg\\Url">
   <modifier>public</modifier> <type class="union"><type>int</type><type>null</type></type><methodname>Uri\WhatWg\Url::getPort</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Метод возвращает порт.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Метод возвращает порт в виде целого числа (&integer;), если объект URL-адреса содержит такой компонент, иначе возвращается &null;.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="uri-whatwg-url.getport.example.basic">
   <title>Пример получения порта методом <methodname>Uri\WhatWg\Url::getPort</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php

$url = new \Uri\WhatWg\Url("https://example.com:8080");
var_dump($url->getPort());

// 443 — стандартный порт для схемы https, поэтому он не сохраняется.
$url = new \Uri\WhatWg\Url("https://example.com:443");
var_dump($url->getPort());
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
int(8080)
NULL
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Uri\WhatWg\Url::withPort</methodname></member>
   <member><methodname>Uri\Rfc3986\Uri::getPort</methodname></member>
  </simplelist>
 </refsect1>
</refentry>
