<refentry xml:id="pdo-pgsql.copytofile" xmlns="http://docbook.org/ns/docbook" xmlns:xi="http://www.w3.org/2001/XInclude">
 <refnamediv>
  <refname>Pdo\Pgsql::copyToFile</refname>
  <refpurpose>Копирует данные из таблицы в файл</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Pdo\\Pgsql">
   <modifier>public</modifier> <type>bool</type><methodname>Pdo\Pgsql::copyToFile</methodname>
   <methodparam><type>string</type><parameter>tableName</parameter></methodparam>
   <methodparam><type>string</type><parameter>filename</parameter></methodparam>
   <methodparam choice="opt"><type>string</type><parameter>separator</parameter><initializer>"\t"</initializer></methodparam>
   <methodparam choice="opt"><type>string</type><parameter>nullAs</parameter><initializer>"\\\\N"</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>fields</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Метод соединяет значения списка полей <parameter>fields</parameter>
   из таблицы <parameter>filename</parameter>
   разделителем <parameter>separator</parameter>
   и копирует данные в файл.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('pdo-pgsql.copyfromarray')/db:refsect1[@role='parameters']//db:varlistentry[db:term[db:parameter[text()='tableName']]]/.)"/>
   <varlistentry>
    <term><parameter>filename</parameter></term>
    <listitem>
     <simpara>
      Имя файла для экспорта данных.
     </simpara>
    </listitem>
   </varlistentry>
   <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('pdo-pgsql.copyfromarray')/db:refsect1[@role='parameters']//db:varlistentry[db:term[db:parameter[text()='separator']]]/.)"/>
   <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('pdo-pgsql.copyfromarray')/db:refsect1[@role='parameters']//db:varlistentry[db:term[db:parameter[text()='nullAs']]]/.)"/>
   <varlistentry>
    <term><parameter>fields</parameter></term>
    <listitem>
     <simpara>
      Список полей для экспорта.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.success;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   При ошибке открытия файла <parameter>filename</parameter> для чтения или записи
   о сбое сообщается через механизм обработки ошибок соединения,
   который устанавливается через атрибут <constant>PDO::ATTR_ERRMODE</constant>;
   в режиме <constant>PDO::ERRMODE_EXCEPTION</constant>
   выбрасывается исключение <exceptionname>PDOException</exceptionname>.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="pdo-pgsql.copytofile.example.basic">
   <title>Пример копирования данных в файл методом <methodname>Pdo\Pgsql::copyToFile</methodname></title>
   <simpara>
    Значения полей таблицы соединяются разделителем <parameter>separator</parameter>
    и записываются в файл <parameter>filename</parameter>
    по одной записи на каждой строке.
   </simpara>
   <programlisting role="php">
<![CDATA[
<?php

$db = new Pdo\Pgsql('pgsql:dbname=test host=localhost', $user, $pass);
$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
$db->exec('CREATE TABLE fruits (id int, name text, qty int)');
$db->exec("INSERT INTO fruits VALUES (1, 'apple', 10), (2, 'banana', 20)");

$db->copyToFile('fruits', '/tmp/fruits.tsv');
echo file_get_contents('/tmp/fruits.tsv');
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
1	apple	10
2	banana	20
]]>
   </screen>
  </example>
 </refsect1>

