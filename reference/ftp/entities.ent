<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.ftp.changelog.mode-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Теперь функция выбрасывает исключение <exceptionname>ValueError</exceptionname>,
   если параметр <parameter>mode</parameter> не равен
   <constant>FTP_ASCII</constant> или <constant>FTP_BINARY</constant>.
   Ранее выдавалась ошибка уровня <constant>E_WARNING</constant>
   и возвращалось значение &false;.
  </entry>
 </row>
</entity>

<entity name="ext.ftp.mode-valueerror">
 <simpara>
  Функция выбрасывает исключение <exceptionname>ValueError</exceptionname>,
  если параметр <parameter>mode</parameter> не равен
  <constant>FTP_ASCII</constant> или <constant>FTP_BINARY</constant>.
 </simpara>
</entity>

</entities>
